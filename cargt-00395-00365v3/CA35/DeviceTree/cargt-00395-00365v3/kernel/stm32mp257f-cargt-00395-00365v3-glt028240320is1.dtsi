/ {
	panel_spi_backlight: panel_spi_backlight {
		/* PB15 is the proven GLT028 backlight net; keep testing PWM on TIM3_CH2 */
		compatible = "pwm-backlight";
		pwms = <&pwm3 1 1000000 0>;
		brightness-levels = <0 100>;
		num-interpolated-steps = <100>;
		default-brightness-level = <100>;
		power-supply = <&scmi_v3v3>;
		status = "okay";
	};
};

&i2c1 {
	status = "okay";

	focaltech_touch: touchscreen@38 {
		compatible = "focaltech,ft6236";
		reg = <0x38>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_spi_touchscreen>;
		interrupt-parent = <&gpiog>;
		interrupts = <14 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&pca9555_20 10 GPIO_ACTIVE_LOW>;
		touchscreen-size-x = <240>;
		touchscreen-size-y = <320>;
		touchscreen-inverted-x;
		wakeup-source;
		status = "okay";
	};
};

/* USART3_TX (PI6) is repurposed as the SPI display D/C GPIO */
&usart3 {
	status = "disabled";
};

&spi4 {
	status = "okay";
	/delete-property/pinctrl-1;
	pinctrl-names = "default";
	pinctrl-0 = <&spi4_pins_mx>;
	cs-gpios = <&gpiod 5 GPIO_ACTIVE_LOW>;

	display@0 {
		compatible = "gtdisplay,glt028240320IS1", "sitronix,st7789t3";
		reg = <0>;
		spi-max-frequency = <12000000>;
		dc-gpios = <&gpioi 6 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pca9555_20 8 GPIO_ACTIVE_HIGH>;
		backlight = <&panel_spi_backlight>;
	};
};

&timers3 {
	/delete-property/pinctrl-names;
	/delete-property/pinctrl-0;
	/delete-property/pinctrl-1;
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "okay";

	pwm3: pwm {
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&pinctrl_glt028_backlight_pwm_default>;
		pinctrl-1 = <&pinctrl_glt028_backlight_pwm_sleep>;
		status = "okay";
	};
};

&pinctrl {
	pinctrl_glt028_backlight_pwm_default: glt028-backlight-pwm-default-0 {
		pins {
			pinmux = <STM32_PINMUX('B', 15, AF7)>; /* TIM3_CH2 on STM32MP257 (old AF2 comment came from earlier STM32 variants) */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
	};

	pinctrl_glt028_backlight_pwm_sleep: glt028-backlight-pwm-sleep-0 {
		pins {
			pinmux = <STM32_PINMUX('B', 15, ANALOG)>; /* TIM3_CH2 */
		};
	};

	pinctrl_spi_tft_dc: spi-tft-dc-0 {
		pins {
			pinmux = <STM32_PINMUX('I', 6, GPIO)>; /* USART3_TX repurposed as SPI TFT D/C */
			drive-push-pull;
			slew-rate = <1>;
		};
	};

	pinctrl_spi_touchscreen: spi-touchscreen-0 {
		pins {
			pinmux = <STM32_PINMUX('G', 14, GPIO)>; /* USART1_TX repurposed as SPI TFT touch INT */
			bias-pull-up;
		};
	};
};
